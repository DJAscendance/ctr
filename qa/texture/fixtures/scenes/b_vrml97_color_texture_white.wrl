#VRML V2.0 utf8
NavigationInfo { type "EXAMINE" headlight TRUE }
Viewpoint { position 0 0 3 }
Background { skyColor [0 0 0] }

# The control: the same texture with nothing to multiply it by.
Shape {
  appearance Appearance {
    material Material { diffuseColor 1 1 1 }
    texture ImageTexture { url "/assets/worlds/ad_col/vrml/wood.jpg" }
  }
  geometry Box { size 2 2 0.01 }
}
