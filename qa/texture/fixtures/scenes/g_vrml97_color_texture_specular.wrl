#VRML V2.0 utf8
NavigationInfo { type "EXAMINE" headlight TRUE }
Viewpoint { position 0 0 3 }
Background { skyColor [0 0 0] }

# specularColor and emissiveColor must survive the diffuse substitution.
Shape {
  appearance Appearance {
    material Material {
      diffuseColor 1 0 0
      specularColor 0 1 0
      emissiveColor 0 0 0.5
      shininess 0.8
    }
    texture ImageTexture { url "/assets/worlds/ad_col/vrml/wood.jpg" }
  }
  geometry Box { size 2 2 0.01 }
}
