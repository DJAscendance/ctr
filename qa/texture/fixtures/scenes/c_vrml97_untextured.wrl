#VRML V2.0 utf8
NavigationInfo { type "EXAMINE" headlight TRUE }
Viewpoint { position 0 0 3 }
Background { skyColor [0 0 0] }

# No texture, so diffuseColor must still decide the surface colour.
Shape {
  appearance Appearance {
    material Material { diffuseColor 1 0 0 }
  }
  geometry Box { size 2 2 0.01 }
}
