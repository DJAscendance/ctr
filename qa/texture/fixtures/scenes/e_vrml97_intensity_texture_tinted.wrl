#VRML V2.0 utf8
NavigationInfo { type "EXAMINE" headlight TRUE }
Viewpoint { position 0 0 3 }
Background { skyColor [0 0 0] }

# A one-component PixelTexture. VRML97 says an intensity map modulates, so this
# one must stay tinted red even after the patch.
Shape {
  appearance Appearance {
    material Material { diffuseColor 1 0 0 }
    texture PixelTexture { image 2 2 1 0x40 0x80 0xC0 0xFF }
  }
  geometry Box { size 2 2 0.01 }
}
