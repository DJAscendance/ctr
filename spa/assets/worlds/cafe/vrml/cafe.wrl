DEF set_FleckR Script {
eventIn SFTime rot
eventIn SFTime blau
eventIn SFTime ohne
eventOut SFTime startTime
eventOut SFNode appearance_changed
field SFNode Fleck_rot Appearance { texture ImageTexture { url "images/fleck1.jpg" }}
field SFNode Fleck_blau Appearance { texture ImageTexture { url "images/fleck2.jpg" }}
field SFNode Fleck_ohne Appearance { texture ImageTexture { url "images/fleck.jpg" }}
url "vrmlscript: function rot (value, time){appearance_changed=Fleck_rot;startTime=time;}
function blau (value, time){appearance_changed=Fleck_blau;startTime=time;}
function ohne (value){appearance_changed=Fleck_ohne;}"}
DEF set_FleckL Script{
eventIn SFTime rot
eventIn SFTime blau
eventIn SFTime ohne
eventOut SFTime startTime
eventOut SFNode appearance_changed
field SFNode Fleck_rot Appearance { texture ImageTexture { url "images/fleck1.jpg" }}
field SFNode Fleck_blau Appearance { texture ImageTexture { url "images/fleck2.jpg" }}
field SFNode Fleck_ohne Appearance { texture ImageTexture { url "images/fleck.jpg" }}
url "vrmlscript:
function rot  (value, time){appearance_changed=Fleck_rot; startTime=time;}
function blau (value, time){appearance_changed=Fleck_blau; startTime=time;}
function ohne (value){appearance_changed=Fleck_ohne;}"}

DEF Rueck_RTS TimeSensor { cycleInterval 60 loop FALSE }
DEF Rueck_LTS TimeSensor { cycleInterval 60 loop FALSE }
DEF IgnoreHistoryTimer TimeSensor { cycleInterval 5 }

DEF Rueck Script {
eventIn SFBool triggerInR
eventIn SFBool triggerInL
eventOut SFTime startTimeR
eventOut SFTime startTimeL
field SFBool on TRUE
url "vrmlscript:
function triggerInR(value, time) {if (value == FALSE) startTimeR = time;}
function triggerInL(value, time) {if (value == FALSE) startTimeL = time;}"} 
#on = 0 ; else#on = 1 ; else 

DEF musicSwitchScript Script {
  eventIn SFString botselection
  eventIn SFTime selection0
  eventIn SFTime selection1
  eventIn SFTime selection2
  eventIn SFTime selection3
  eventIn SFBool description0
  eventIn SFBool description1
  eventIn SFBool description2
  eventIn SFBool description3
  eventIn SFBool ignoreHistory
  eventIn SFBool startHistory2
  field SFBool musicEnabled FALSE
  field MFString newurl [ "" ]
  field MFString param [ "" "" ]
  field MFString curselection [ "Current Title:", "" ]
  field MFString curdescription [ "" ]
  field MFString titles [ "Gimmie Shelter", "Baker Street", "Dixie", "Shine on you crazy diamond" ]
  eventOut SFBool startHistory1
  eventOut SFTime startHistoryTimer
  eventOut MFString selection
  eventOut MFString description 
  url "vrmlscript:
    function initialize() {
        startHistory1 = TRUE;
    }
    function startHistory2(val, time) {
        startHistoryTimer = time;
    }
    function ignoreHistory(val, time) {
      if (!val)
        musicEnabled = TRUE;
    }
    function botselection(val, time) {
      if (!musicEnabled)
        return;
      i = val.indexOf('http');
      k = val.indexOf('.mid');
      if (i > 0 && k > 0)
      {
        j = val.indexOf(' ', i);
        if (j > 0)
        {
          newurl[0] = '/cgi-bin/colonycity/cafe?ac=sound&SF=' + val.substring(i, j);
          curselection[1] = val.substring(j+1, val.length);
        }
        else
        {
          newurl[0] = '/cgi-bin/colonycity/cafe?ac=sound&SF=' + val.substring(i, val.length);
          curselection[1] = val.substring(i, val.length);
        }
        selection = curselection;
      }
      else
      {
        Browser.setDescription('Sorry, no valid URL of midi sound specified');
      }
    }             
    function selection0(val, time) {
      curselection[1] = titles[0];
      selection = curselection;
    }             
    function selection1(val, time) {
      curselection[1] = titles[1];
      selection = curselection;
    }             
    function selection2(val, time) {
      curselection[1] = titles[2];
      selection = curselection;
    }             
    function selection3(val, time) {
      curselection[1] = titles[3];
      selection = curselection;
    }             
    function description0(val, time) {
     if (val)
     {
       curdescription[0] = titles[0];
       description = curdescription;
     }
     else
     {
       curdescription[0] = '';
       description = curdescription;
     }
    }             
    function description1(val, time) {
     if (val)
     {
       curdescription[0] = titles[1];
       description = curdescription;
     }
     else
     {
       curdescription[0] = '';
       description = curdescription;
     }
    }             
    function description2(val, time) {
     if (val)
     {
       curdescription[0] = titles[2];
       description = curdescription;
     }
     else
     {
       curdescription[0] = '';
       description = curdescription;
     }
    }             
    function description3(val, time) {
     if (val)
     {
       curdescription[0] = titles[3];
       description = curdescription;
     }
     else
     {
       curdescription[0] = '';
       description = curdescription;
     }
    }             
  "
}
             
# ---------------------------------------------------------------------------
# ENTRANCE VOID GUARD (CTR reconstruction).
#
# Walking backward out of the entrance took a citizen over the threshold at
# about z -20, past the last authored floor polygon, and into free fall. Measured
# on the running world: safe ground reaches z -20.6, and the avatar is already
# falling by z -22.3. Of eight walked headings from the entry viewpoint only this
# one left the world.
#
# The strip outside the door was measured by walking it: ground runs from about
# x -20.6 to x +21.7 and ends between z -20.7 and z -22. So the guard is three
# thin pieces, not one. The back piece at z -21 stops the walk out. The two end
# pieces stop what the back piece alone produced: the citizen pressed against it
# and slid sideways the full width of the building until the ground ran out.
# Together with the authored door wall the three pieces close the strip. Six
# escape runs, including a forty second grind, now all stop inside.
#
# The pieces stand in the gap, outside every authored
# surface, so nothing visible and nothing authored changes: no new geometry the
# citizen can see, no edit to the floor, no edit to the entry viewpoint, and no
# edit to the Plaza door. The door sits nearer the citizen at about z -19.5, so
# it still takes the touch ray first and still works.
#
# Each piece is a Collision `proxy`, which is VRML97's own name for geometry that
# collides and is never drawn. A fully transparent Shape was tried first and the
# citizen walked straight through it: X_ITE drops a transparency 1 Shape before
# collision ever sees it. A proxy cannot be dropped that way and needs no
# Appearance at all, so there is nothing to render and nothing to look wrong.
# ---------------------------------------------------------------------------
DEF EntranceVoidGuard Group { children [
# back: stops the walk out of the doorway at z -21
Transform { translation 1 3 -21 children [
Collision { collide TRUE proxy Shape { geometry Box { size 52 10 0.4 } } children [] }
]},
# west end: stops the slide along the back guard off the x -20.6 edge
Transform { translation -20.8 3 -19.8 children [
Collision { collide TRUE proxy Shape { geometry Box { size 0.4 10 3.6 } } children [] }
]},
# east end: the same on the x +21.7 edge
Transform { translation 21.2 3 -19.8 children [
Collision { collide TRUE proxy Shape { geometry Box { size 0.4 10 3.6 } } children [] }
]}
]}

# ---------------------------------------------------------------------------
# JUKEBOX AUDIO (deferred).
#
# The four buttons historically loaded audio/audioN.htm, which embedded sN.mid
# in an HTML frame named "audio". CTR has no such frame and browsers no longer
# play MIDI, so that path stays disabled: no popup, no HTML frame, no MIDI
# request.
#
# The four historical MIDI files remain on disk in audio/ as source evidence
# only. Nothing in this world references them at runtime.
#
# A set of converted OGG renders was tried here and removed: the four clips
# eager-loaded about 14 MB on every world entry, and the replacement audio has
# not been approved. The jukebox is deliberately silent for now.
#
# The buttons keep their historical behaviour otherwise: pressing one still
# updates the title sign through musicSwitchScript, and the mute button keeps
# its historical geometry and TouchSensor as an inert control.
#
# To restore audio later: add one Sound/AudioClip per track plus a selector
# script, and route TouchTasteN.touchTime into it. Do not reintroduce the
# audioN.htm popup path.
# ---------------------------------------------------------------------------
DEF SloadPlace Script {
    field MFString newurl [ "" ]
    field MFString param [ "" "" ]
        eventIn SFBool loadPlaza
        eventIn SFBool describePlaza
        eventIn SFVec3f describe1Plaza
        url "vrmlscript:
    function initialize(){
      /* Historically this posted to the colonycity 'action' CGI endpoint to open
         the HTML action frame. That host and that frame are both gone, so the
         request is a guaranteed 404. The door below still works without it. */
    }
    function describePlaza(value,ts){
        if ( value )
            Browser.setDescription( 'Plaza' );
        else
            Browser.setDescription( '             ' );
    }
    function describe1Plaza(value,ts){
            Browser.setDescription( 'Go to Plaza' );
    }
        function loadPlaza (value, ts) {
      /* Historically: the TRUE edge muted the jukebox by loading a blank page
         into the HTML `audio` frame, and the FALSE edge left for the Plaza with
         `Browser.loadURL('../../enter/vrml/enter.wrl', 'target=_self')`. CTR has
         no `audio` frame, and `target=_self` would replace the whole SPA with a
         raw .wrl file. The Plaza is a current CTR route, so the exit keeps its
         historical destination through the same hash route post.wrl uses. */
      if ( !value )
        window.location.href = '/#/place/enter';
    }
        "
}
#        Browser.loadURL (newurl,param);
#        newurl[0] = '/cgi-bin/colonycity/enter?ac=actionfs&ID=0000000000000001';
#        param[0] = 'target=action';
#        param[1] = '';

DEF TPlaza TimeSensor {}
ROUTE TSPlaza.touchTime TO TPlaza.startTime
ROUTE TSPlaza1.touchTime TO TPlaza.startTime
ROUTE TPlaza.isActive  TO SloadPlace.loadPlaza
ROUTE TSPlaza.isOver TO SloadPlace.describePlaza
ROUTE TSPlaza1.isOver TO SloadPlace.describePlaza
ROUTE TSPlaza.hitPoint_changed TO SloadPlace.describe1Plaza
ROUTE TSPlaza1.hitPoint_changed TO SloadPlace.describe1Plaza

#Begin sound routes

# The title sign is driven off the same direct press, so the citizen who pressed
# the button sees the song name without waiting for a shared-event round trip.
ROUTE TouchTaste0.touchTime TO musicSwitchScript.selection0
ROUTE TouchTaste1.touchTime TO musicSwitchScript.selection1
ROUTE TouchTaste2.touchTime TO musicSwitchScript.selection2
ROUTE TouchTaste3.touchTime TO musicSwitchScript.selection3

ROUTE TouchTaste0.isOver TO musicSwitchScript.description0
ROUTE TouchTaste1.isOver TO musicSwitchScript.description1
ROUTE TouchTaste2.isOver TO musicSwitchScript.description2
ROUTE TouchTaste3.isOver TO musicSwitchScript.description3
ROUTE TouchTaste0.touchTime TO Taste0.set_time
ROUTE TouchTaste1.touchTime TO Taste1.set_time
ROUTE TouchTaste2.touchTime TO Taste2.set_time
ROUTE TouchTaste3.touchTime TO Taste3.set_time
ROUTE Taste0.time_changed TO musicSwitchScript.selection0
ROUTE Taste1.time_changed TO musicSwitchScript.selection1
ROUTE Taste2.time_changed TO musicSwitchScript.selection2
ROUTE Taste3.time_changed TO musicSwitchScript.selection3
ROUTE Botsound.string_changed TO musicSwitchScript.botselection
ROUTE musicSwitchScript.description TO TitleDescription.set_string
ROUTE musicSwitchScript.selection TO CurTitle.set_string
ROUTE musicSwitchScript.startHistory1 TO musicSwitchScript.startHistory2
ROUTE musicSwitchScript.startHistoryTimer TO IgnoreHistoryTimer.set_startTime
ROUTE IgnoreHistoryTimer.isActive TO musicSwitchScript.ignoreHistory

