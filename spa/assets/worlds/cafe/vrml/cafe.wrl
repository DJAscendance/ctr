# PlaneSensor Shared
ROUTE FlascheRL.offset_changed TO SharedTranslationFRL.set_vec3f
ROUTE SharedTranslationFRL.vec3f_changed TO FlascheRLT.set_translation
ROUTE FlascheRR.offset_changed TO SharedTranslationFRR.set_vec3f
ROUTE SharedTranslationFRR.vec3f_changed TO FlascheRRT.set_translation
