ROUTE Slot1.vrmlLoaded TO VrmlLoaded.set_bool
ROUTE Slot1.points TO SharedScore.set_int32
ROUTE NewScoreBack.string_changed TO Slot1.highscorelist

# Insert for banner
Transform {
translation  3.56 2 16
rotation 0 1 0 3.14159265 
children [
Transform {
rotation 0 1 0 .89
children [
                        
# MISSING_SOURCE_ASSET
#   historical target : ../../banners/3d/cafe_ban1.wrl
#   state            : not present in the recovered Le Cafe source, and not
#                      present anywhere in spa/assets. Every request for it
#                      returns 404.
#   why disabled     : an Inline that can never resolve is a guaranteed runtime
#                      404 on every world entry. The Transform that positioned
#                      the banner is kept verbatim above so the historical
#                      placement survives; only the request is removed.
#   do not           : invent banner geometry or art, or substitute a modern ad.
#                      Re-enable this Inline only if the real cafe_ban1.wrl and
#                      its textures are recovered.
# Inline {
# url "../../banners/3d/cafe_ban1.wrl"
# }
]
}
]
},
# end insert for banner
Transform{translation 18 3 -6 rotation 0 1 0 1.571
children[

