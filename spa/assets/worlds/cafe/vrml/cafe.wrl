ROUTE SharedTimerFBL.time_changed TO Rueck_LTS.set_startTime

# common
ROUTE set_FleckR.appearance_changed TO FleckL.set_appearance
ROUTE set_FleckL.appearance_changed TO FleckR.set_appearance
ROUTE set_FleckR.startTime TO Rueck_RTS.startTime
ROUTE set_FleckL.startTime TO Rueck_LTS.startTime
