CHAT_WEBHOOK_URL="https://webhook.example"
DB_HOST="db"
DB_PORT=3306
DB_USER="root"
DB_PASS="pw"
DB_DATABASE="cybertown"
JWT_SECRET="devsecret"
NODE_ENV="development"
ASSETS_DIR="/usr/src/spa/assets"
# Private, non-public storage for home images awaiting moderation. Must be OUTSIDE
# ASSETS_DIR and any nginx-served path so unchecked images cannot be fetched directly.
PRIVATE_UPLOADS_DIR="/usr/src/app/private-uploads"
